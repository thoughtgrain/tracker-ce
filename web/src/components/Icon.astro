---
// A Phosphor icon, inlined at build time. Pass `label` when the icon carries meaning on its own;
// leave it out when text beside it already says the same thing.
import { iconSvg } from "../lib/phosphor.mjs";

interface Props {
  name: string;
  weight?: "thin" | "light" | "regular" | "bold" | "fill" | "duotone";
  label?: string;
  class?: string;
}
const { name, weight, label, class: className } = Astro.props;
const svg = iconSvg(name, { weight, label, className: ["ph-icon", className].filter(Boolean).join(" ") });
---

<Fragment set:html={svg} />
