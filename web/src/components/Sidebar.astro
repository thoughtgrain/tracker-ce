---
import { Content as Sidebar } from '../../../docs/_Sidebar.md';

import './sidebar.scss';
---

<button
    class="nav-button"
    type="button"
    aria-controls="docs-nav"
    aria-expanded="true"
>
  <span aria-hidden="true">&#x2630;</span> Contents
</button>

<nav id="docs-nav" class="sidebar" aria-label="Documentation">
    <Sidebar class="sidebar-content" />
</nav>

<script>
    const sidebar = document.querySelector('.sidebar'),
        navButton = document.querySelector('.nav-button'),
        article = document.querySelector('.article-content'),
        buttonColors = ['note-color', 'instrument-color', 'fx1-color', 'fx2-color'];

    const setOpen = (open: boolean) => {
        sidebar?.classList.toggle('hidden', !open);
        article?.classList.toggle('hidden', open && breakpoint.matches);
        navButton?.setAttribute('aria-expanded', String(open));
    };
    const breakpoint = window.matchMedia('(max-width: 779px)');

    if (sidebar) {
        navButton?.addEventListener('click', () => setOpen(sidebar.classList.contains('hidden')));

        // On phones the contents start folded away; on wider screens they're always shown.
        const updateVisibility = () => setOpen(!breakpoint.matches);

        updateVisibility();
        breakpoint.addEventListener('change', updateVisibility);
    }

    // Mark the page we're on so the list shows where you are.
    const here = location.pathname.replace(/\/?$/, '/');
    sidebar?.querySelectorAll('a').forEach((a) => {
        if (new URL(a.href).pathname.replace(/\/?$/, '/') === here) a.setAttribute('aria-current', 'page');
    });

    navButton?.classList.add(buttonColors[Math.floor(Math.random() * 4)])
</script>
