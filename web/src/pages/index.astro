---
import "@fontsource/bebas-neue/400.css";
import "@fontsource-variable/albert-sans/wght.css";
import "@fontsource/jetbrains-mono/500.css";
import "../styles/global.css";

import Head from "../components/Head.astro";
import SiteHeader from "../components/SiteHeader.astro";
import TrackerDrawing from "../components/TrackerDrawing.astro";
import { getReleaseInfo, stageOf, formatSize, type Release, type Device } from "../lib/releases";
import { repoUrl, releasesUrl, docsUrl, polyend, recoveryVideo } from "../config";

const info = await getReleaseInfo();
const latest = info.preview ?? info.stable;
const releases = [info.preview, info.stable].filter((r): r is Release => !!r);
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
// The repo's guides are rendered as pages under /docs/ (see src/pages/docs).
const docPage = (slug: string) => `${base}docs/${slug}/`;

const deviceNames: Record<Device, string> = {
  original: "Original Tracker",
  plus: "Tracker+",
  mini: "Tracker Mini",
};
const dateFmt = new Intl.DateTimeFormat("en", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });

// Card colours are the Tracker's Note / Instrument / FX1 / FX2 keys; each card also names its group.
type Group = "note" | "instr" | "fx1" | "fx2";
const groupLabel: Record<Group, string> = { note: "Sound", instr: "Sequencing", fx1: "Workflow", fx2: "Make it yours" };
const features: { group: Group; title: string; body: string; devices: string; doc?: string }[] = [
  { group: "note", title: "Open synth engines", body: "A plugin SDK for synth engines loaded from the SD card. CHIP and DIRT ship with it, and anyone can build more.", devices: "Tracker+ · Mini", doc: "custom_synth_sdk" },
  { group: "note", title: "Sample editor plugins", body: "Swappable effects and generators in /Effects, up to 12 parameters each. Six reference plugins included.", devices: "All three", doc: "modular_effects_system" },
  { group: "note", title: "Wavetable envelopes", body: "256 morphable contours with Warp X/Y across seven instrument parameters, plus the w and y step FX.", devices: "All three", doc: "wavetable_envelopes" },
  { group: "instr", title: "Micro-move and volume", body: "Every step stores its own m and V values, so Fx1 and Fx2 stay free. Press Note on the note column to flip views.", devices: "All three" },
  { group: "instr", title: "More chance", body: "Group with last, not last, play N / skip M and skip N / play M, alongside the usual percentage.", devices: "All three" },
  { group: "instr", title: "Slices play through", body: "Slice and Beat Slice instruments can keep playing past their marker until the note ends.", devices: "All three" },
  { group: "fx1", title: "Sample streaming", body: "Long samples keep only their attack in RAM and stream the rest from the card, so a project holds far more audio.", devices: "All three" },
  { group: "fx1", title: "Performance pages", body: "Keep pressing Perform to switch between sample tracks and MIDI/synth tracks.", devices: "All three" },
  { group: "fx2", title: "Themes and fonts", body: "Load your own colour themes and antialiased fonts from the SD card, made in the web editor.", devices: "All three", doc: "custom_themes_and_fonts" },
  { group: "fx2", title: "Image viewer", body: "Three folders of reference images, notes or anything else, flipped through with the pads.", devices: "All three", doc: "image_viewer" },
];

const devices: { model: Device; desc: string; chip: string; file: string }[] = [
  { model: "original", desc: "A light grey Tracker with screen, encoder and 48 pads.", chip: "MK66, Cortex-M4F at 180 MHz", file: "PolyendTracker_*.ptf" },
  { model: "plus", desc: "A graphite Tracker+ with screen, encoder and 48 pads.", chip: "i.MX RT, Cortex-M7 at 600 MHz", file: "TrackerPlus_*.ptf" },
  { model: "mini", desc: "A compact grey Tracker Mini with screen and two rows of keys.", chip: "i.MX RT, Cortex-M7 at 600 MHz", file: "TrackerMini_*.ptf" },
];

// The four key colours, used for the decorative light streaks.
const streak = "linear-gradient(90deg, #dcaaf0, #eef0a0 45%, #8ff0d6 75%, #a2e8f2)";
const streakV = "linear-gradient(180deg, #8ff0d6, #eef0a0 45%, #dcaaf0)";
---

<!doctype html>
<html lang="en">
  <head>
    <Head
      title="Tracker CE · Community firmware for the Polyend Tracker"
      description="Unofficial community firmware for the Original Polyend Tracker, Tracker+ and Tracker Mini. Download the latest release and see what's new."
    />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="wrap">
      <SiteHeader current="home" />

      <main id="main">
        <section class="hero" aria-labelledby="hero-title">
          <div class="hero-copy">
            <span class="unofficial">Unofficial · made by the community</span>
            <h1 id="hero-title">Tracker.<br />Community Edition.</h1>
            <p class="hero-sub">Firmware for the Original Tracker, Tracker+ and Tracker Mini</p>
            <div class="pill-row">
              <a class="pill solid" href="#download">{latest ? `Get ${latest.tag}` : "Get the firmware"}</a>
              <a class="pill" href={repoUrl} rel="noopener">Source on GitHub</a>
            </div>
          </div>
          <div class="hero-art">
            <span class="glow" aria-hidden="true" style={`left:-25%;right:-30%;top:64%;height:22px;background:${streak}`}></span>
            <span class="glow sharp" aria-hidden="true" style={`left:-15%;right:-30%;top:calc(64% + 6px);height:10px;background:${streak};opacity:.9`}></span>
            <span class="glow" aria-hidden="true" style={`left:60%;width:20px;top:-80%;bottom:-80%;background:${streakV};opacity:.45`}></span>
            <TrackerDrawing
              model="plus"
              title="Drawing of a Tracker+"
              description="A graphite Tracker+ with its screen showing a pattern in note, instrument and effect colours, a sample strip beside one track, the encoder, and 48 pads."
            />
          </div>
        </section>

        <div class="statement">
          <p>
            Polyend open-sourced the Tracker firmware, and <strong>Tracker CE picks it up from there</strong>. Same
            workflow, same projects, same muscle memory.
          </p>
          <p>
            Adding <strong>synth and effect plugins</strong>, <strong>wavetable modulation</strong>, <strong>sample streaming</strong> and <strong>dedicated m and V columns</strong> across all three devices.
          </p>
        </div>

        <section id="download" class="panel" aria-labelledby="download-title">
          <h2 id="download-title">Latest build</h2>
          <p>This list refreshes itself: every time the site is built it reads the newest releases from GitHub.</p>

          {latest ? (
            releases.map((r) => (
              <article class="release" aria-labelledby={`rel-${r.tag}`}>
                <div class="release-head">
                  <div>
                    <h3 id={`rel-${r.tag}`} class="release-tag">{r.tag}</h3>
                    <p class="release-meta">
                      Published <time datetime={r.publishedAt.toISOString()}>{dateFmt.format(r.publishedAt)}</time>
                    </p>
                  </div>
                  <span class={`stage${r.prerelease ? "" : " stable"}`}>
                    {r.prerelease ? (stageOf(r.tag) ?? "Pre-release") : "Stable"}
                  </span>
                </div>
                {r.prerelease && (
                  <p class="warn">
                    A test build. Back up your Projects folder first: projects saved on CE can't be opened by older firmware.
                  </p>
                )}
                <ul class="files">
                  {(Object.keys(deviceNames) as Device[]).map((d) => {
                    const f = r.firmware[d];
                    return (
                      <li class="file">
                        <div>
                          <span class="file-for">{deviceNames[d]}</span>
                          {f && <span class="file-name">{f.name} · {formatSize(f.size)}</span>}
                        </div>
                        {f ? (
                          <a class="pill" href={f.url}>Download<span class="sr-only"> {f.name} for {deviceNames[d]}</span></a>
                        ) : (
                          <span class="missing">Not in this release</span>
                        )}
                      </li>
                    );
                  })}
                  {r.synths && (
                    <li class="file">
                      <div>
                        <span class="file-for">Synth engines</span>
                        <span class="file-name">{r.synths.name} · {formatSize(r.synths.size)} · Tracker+ and Mini</span>
                      </div>
                      <a class="pill" href={r.synths.url}>Download<span class="sr-only"> {r.synths.name}</span></a>
                    </li>
                  )}
                  {r.effects && (
                    <li class="file">
                      <div>
                        <span class="file-for">Sample editor effects</span>
                        <span class="file-name">{r.effects.name} · {formatSize(r.effects.size)} · all three</span>
                      </div>
                      <a class="pill" href={r.effects.url}>Download<span class="sr-only"> {r.effects.name}</span></a>
                    </li>
                  )}
                </ul>
                <div class="release-foot">
                  <a class="pill" href={r.url} rel="noopener">Release notes</a>
                  <a class="pill" href={releasesUrl} rel="noopener">All releases</a>
                </div>
              </article>
            ))
          ) : (
            <div class="release">
              <p class="warn" style="margin-top:1.5rem">
                {info.error ? "The release list couldn't be read when this page was built." : "There's no published release yet."}{" "}
                The current builds are always on GitHub.
              </p>
              <a class="pill solid" href={releasesUrl} rel="noopener">Open the releases page</a>
            </div>
          )}
        </section>

        <section id="features" class="block" aria-labelledby="features-title">
          <h2 id="features-title">Same Tracker,<br />more of it</h2>
          <p>A short tour of 1.0. The <a href={docPage("CHANGELOG")}>changelog</a> has every change and fix.</p>
          <div class="cards">
            {features.map((f) => (
              <article class={`card ${f.group}`}>
                <span class="tag">{groupLabel[f.group]}</span>
                <h3>{f.title}</h3>
                <p>{f.body}</p>
                <div class="foot">
                  <span class="on">{f.devices}</span>
                  {f.doc && <a class="pill" href={docPage(f.doc)}>Guide<span class="sr-only"> for {f.title}</span></a>}
                </div>
              </article>
            ))}
          </div>
        </section>

        <section id="devices" class="block" aria-labelledby="devices-title">
          <h2 id="devices-title">Every Tracker</h2>
          <p>One firmware tree, a file per device. The synth engines need the faster chip in Tracker+ and Mini; everything else runs on all three.</p>
          <div class="devices">
            {devices.map((d) => (
              <figure class="device">
                <TrackerDrawing model={d.model} class={d.model === "mini" ? "mini" : undefined} title={`Drawing of the ${deviceNames[d.model]}`} description={d.desc} />
                <figcaption>
                  <h3>{deviceNames[d.model]}</h3>
                  <p>{d.chip}</p>
                  <p><code>{d.file}</code></p>
                </figcaption>
              </figure>
            ))}
          </div>
        </section>

        <section id="install" class="block" aria-labelledby="install-title">
          <h2 id="install-title">Install</h2>
          <ol class="steps">
            <li><p>Back up the <strong>Projects</strong> folder on your SD card. Projects saved on CE use pattern format 6, which older firmware can't read.</p></li>
            <li><p>Copy the <code>.ptf</code> for your Tracker into <code>/Firmware/</code> on the card. Keep the file name to 31 characters or fewer.</p></li>
            <li><p>On the Tracker, open <strong>Config › Firmware › Firmware update</strong>, pick the file and confirm.</p></li>
            <li><p>Optional: unzip the Effects (all three) or Synths (Tracker+ and Mini) bundle and copy its folder to the root of the card.</p></li>
          </ol>
          <div class="recovery">
            <h3>If an update won't boot</h3>
            <p>
              The bootloader is separate from the firmware, so a Tracker can always be recovered. Put a known-good
              <code>.ptf</code> alone in <code>/Firmware/</code>, power on, and press the reset pinhole with a paperclip. It's on
              the bottom of the Original and Tracker+, and next to the USB-C port on the Mini.
            </p>
            <a class="pill" href={recoveryVideo} rel="noopener">Watch the recovery video</a>
          </div>
        </section>

        <section id="docs" class="block" aria-labelledby="docs-title">
          <h2 id="docs-title">Manuals and docs</h2>
          <p>Polyend's manuals still cover everything the Tracker already did. The CE guides cover what's new.</p>
          <div class="tiles">
            <a class="tile" href={polyend.downloads.original} rel="noopener"><span class="src">Polyend</span><h3>Tracker manual</h3><p>Manual and stock firmware for the Original Tracker</p></a>
            <a class="tile" href={polyend.downloads.plus} rel="noopener"><span class="src">Polyend</span><h3>Tracker+ manual</h3><p>Manual and stock firmware for Tracker+</p></a>
            <a class="tile" href={polyend.downloads.mini} rel="noopener"><span class="src">Polyend</span><h3>Tracker Mini manual</h3><p>Manual and stock firmware for Tracker Mini</p></a>
            <a class="tile" href={polyend.backstage} rel="noopener"><span class="src">Community</span><h3>Backstage forum</h3><p>Where Tracker people talk</p></a>
            <a class="tile" href={docPage("wavetable_envelopes")}><span class="src">CE guide</span><h3>Wavetable envelopes</h3><p>WT Env, WT LFO and the w / y step FX</p></a>
            <a class="tile" href={docPage("custom_themes_and_fonts")}><span class="src">CE guide</span><h3>Themes and fonts</h3><p>Making your own</p></a>
            <a class="tile" href={docPage("custom_synth_sdk")}><span class="src">Build</span><h3>Synth SDK</h3><p>Writing a .psyn engine</p></a>
            <a class="tile" href={docPage("developer_guide")}><span class="src">Build</span><h3>Developer guide</h3><p>Toolchain, structure, memory, contributing</p></a>
          </div>
          <p style="margin-top:1.5rem"><a class="pill" href={`${base}docs/`}>All the docs</a></p>
        </section>
      </main>

      <footer class="site-foot">
        <p>
          <strong>Use at your own risk.</strong> Tracker CE is community firmware, not an official Polyend release, and
          Polyend doesn't support it. Keep a backup of your projects.
        </p>
        <p>
          Polyend and Tracker are trademarks of Polyend. The drawings on this page are impressions, not product photos.
          Firmware source under the <a href={docsUrl("LICENSE")} rel="noopener">repository licence</a> ·
          <a href={polyend.home} rel="noopener">polyend.com</a> ·
          <a href={polyend.support} rel="noopener">Polyend support</a>
        </p>
      </footer>
    </div>
  </body>
</html>
