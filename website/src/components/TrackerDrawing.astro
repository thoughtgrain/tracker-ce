---
// Drawn impressions of the three Trackers (not product photos): a body, the screen showing a tiny
// pattern in the Tracker's own column colours with a sample strip, the encoder, the screen
// buttons and, on the Original and Tracker+, the 48 pads.
interface Props {
  model: "original" | "plus" | "mini";
  title: string;
  description?: string;
  class?: string;
}
const { model, title, description, class: className } = Astro.props;
const id = `drawing-${model}-${Math.random().toString(36).slice(2, 8)}`;

const isMini = model === "mini";
const W = isMini ? 300 : 440;
const H = isMini ? 250 : 300;

// Body tone per model: the Original light, Tracker+ graphite, Mini a mid grey.
const body = { original: "var(--dev-body-light)", plus: "var(--dev-body-dark)", mini: "var(--dev-body-mid)" }[model];
const edge = "var(--dev-edge)";

// Screen geometry.
const scr = isMini ? { x: 30, y: 28, w: 240, h: 112 } : { x: 28, y: 26, w: 250, h: 118 };

// A deterministic little pattern: four tracks, rows of note / instrument / fx dashes.
const rows = 9;
const cols = ["note", "instr", "fx1", "fx2"] as const;
const rowH = (scr.h - 18) / rows;
const trackW = (scr.w - 16) / 4;
const lit = (t: number, r: number) => ((t * 7 + r * 3) % 5 === 0) || (t === 2 && r % 4 === 0);
const cells: { x: number; y: number; w: number; c: string }[] = [];
for (let t = 0; t < 4; t++) {
  for (let r = 0; r < rows; r++) {
    if (!lit(t, r)) continue;
    const x0 = scr.x + 8 + t * trackW;
    const y = scr.y + 12 + r * rowH;
    const widths = [12, 7, 11, 11];
    let x = x0;
    cols.forEach((c, i) => {
      if (i < 2 || (t + r) % 2 === 0) cells.push({ x, y, w: widths[i], c });
      x += widths[i] + 3;
    });
  }
}
// The sample strip beside track 2: a waveform running down with the rows.
const stripX = scr.x + 8 + 2 * trackW - 6;
const strip: { y: number; half: number }[] = [];
for (let i = 0; i < rows * 3; i++) {
  const v = Math.abs(Math.sin(i * 0.9) * 0.7 + Math.sin(i * 0.31) * 0.3);
  strip.push({ y: scr.y + 12 + i * (rowH / 3), half: 0.6 + v * 2.6 });
}
const playRow = 4;

// 48 pads in 4 rows of 12.
const pads: { x: number; y: number; on: boolean }[] = [];
if (!isMini) {
  const px = 28, py = 176, pw = 384 / 12, ph = 22;
  for (let r = 0; r < 4; r++)
    for (let c = 0; c < 12; c++)
      pads.push({ x: px + c * pw, y: py + r * (ph + 4), on: (r === 1 && c === 4) || (r === 3 && c === 0) || (r === 2 && c === 9) });
}
// Screen buttons under the screen.
const btnY = scr.y + scr.h + 10;
const btns = Array.from({ length: 8 }, (_, i) => ({ x: scr.x + i * (scr.w / 8) + 3, w: scr.w / 8 - 6 }));
---

<svg
  class={className}
  viewBox={`0 0 ${W} ${H}`}
  role="img"
  aria-labelledby={`${id}-t${description ? ` ${id}-d` : ""}`}
  xmlns="http://www.w3.org/2000/svg"
>
  <title id={`${id}-t`}>{title}</title>
  {description && <desc id={`${id}-d`}>{description}</desc>}

  <rect x="4" y="6" width={W - 8} height={H - 10} rx="14" fill="var(--dev-shadow)" />
  <rect x="2" y="2" width={W - 8} height={H - 10} rx="14" fill={body} stroke={edge} stroke-width="1.5" />

  <!-- screen -->
  <rect x={scr.x - 4} y={scr.y - 4} width={scr.w + 8} height={scr.h + 8} rx="5" fill="var(--dev-bezel)" />
  <rect x={scr.x} y={scr.y} width={scr.w} height={scr.h} rx="2" fill="#000" />
  <rect x={scr.x} y={scr.y + 12 + playRow * rowH - 1} width={scr.w} height={rowH} fill="#123129" />
  {cells.map((c) => (
    <rect x={c.x} y={c.y} width={c.w} height="3" rx="1" class={`px-${c.c}`} />
  ))}
  {strip.map((s) => (
    <line x1={stripX - s.half} y1={s.y} x2={stripX + s.half} y2={s.y} stroke="#c9c9cc" stroke-width="1" />
  ))}
  <rect x={scr.x} y={scr.y + scr.h - 10} width={scr.w} height="10" fill="#1f1f22" />
  {btns.map((b) => <rect x={b.x} y={scr.y + scr.h - 8} width={b.w} height="6" rx="1" fill="#3a3a3e" />)}

  <!-- screen buttons -->
  {btns.map((b) => <rect x={b.x} y={btnY} width={b.w} height="9" rx="2" fill="var(--dev-key)" stroke={edge} stroke-width="0.8" />)}

  {isMini ? (
    <>
      <!-- the Mini: no pads or encoder; rows of keys and the ±1 / ±10 buttons -->
      {Array.from({ length: 2 }, (_, r) =>
        Array.from({ length: 10 }, (_, c) => (
          <rect x={30 + c * 24} y={178 + r * 26} width="18" height="16" rx="3" fill="var(--dev-key)" stroke={edge} stroke-width="0.8" />
        ))
      )}
    </>
  ) : (
    <>
      <!-- encoder -->
      <circle cx="350" cy="84" r="34" fill="var(--dev-knob)" stroke={edge} stroke-width="1.5" />
      <circle cx="350" cy="84" r="24" fill="none" stroke="var(--dev-knob-ring)" stroke-width="1" />
      <line x1="350" y1="84" x2="350" y2="64" stroke="var(--dev-knob-mark)" stroke-width="3" stroke-linecap="round" />
      <!-- function keys beside the encoder -->
      {Array.from({ length: 3 }, (_, i) => (
        <rect x={312 + i * 28} y="132" width="22" height="10" rx="2" fill="var(--dev-key)" stroke={edge} stroke-width="0.8" />
      ))}
      <!-- 48 pads -->
      {pads.map((p) => (
        <rect x={p.x + 2} y={p.y} width={384 / 12 - 4} height="22" rx="3" fill={p.on ? "var(--dev-pad-on)" : "var(--dev-pad)"} stroke={edge} stroke-width="0.8" />
      ))}
    </>
  )}
</svg>

<style>
  .px-note { fill: #00e8be; }
  .px-instr { fill: #fef749; }
  .px-fx1 { fill: #bb58f1; }
  .px-fx2 { fill: #57f1ff; }
</style>
